---
import { profile } from '../data/profile';
import SectionHead from './SectionHead.astro';

const yearOf = (date: string) => date.match(/\d{4}/)?.[0] ?? date;

const entries = profile.experience.map((job) => {
  const roles = [job, ...(job.alsoAs ?? [])];
  const first = roles[roles.length - 1];
  return {
    ...job,
    roles,
    span: `${yearOf(first.start)} — ${job.end === 'Present' ? 'now' : yearOf(job.end)}`,
  };
});
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <SectionHead id="experience-title" {...profile.home.experience} />

    <ol class="timeline">
      {
        entries.map((entry) => (
          <li class="entry">
            <p class="span">{entry.span}</p>
            <div class="entry-body">
              <div class="roles">
                {entry.roles.map((role) => (
                  <div class="role">
                    <h3>{role.title}</h3>
                    <p class="where">
                      {role.company} · {role.location} · <span class="dates">{role.start} – {role.end}</span>
                    </p>
                  </div>
                ))}
              </div>
              <ul class="dash-list">
                {entry.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entry {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 2rem;
    padding-block: 2.25rem;
    border-top: 1px solid var(--rule);
  }

  .entry:first-child {
    border-top: 1px solid var(--ink);
  }

  .span {
    font-family: var(--serif);
    font-size: 1.25rem;
    color: var(--accent);
    white-space: nowrap;
  }

  .entry-body {
    display: grid;
    gap: 1.25rem;
    max-width: 48rem;
  }

  .roles {
    display: grid;
    gap: 0.9rem;
  }

  h3 {
    font-size: 1.5rem;
  }

  .where {
    margin-top: 0.3rem;
    color: var(--ink);
    font-size: 0.975rem;
  }

  .dates {
    color: var(--ink-3);
  }

  .dash-list {
    font-size: 0.975rem;
  }

  @media (max-width: 720px) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
    }
  }
</style>
