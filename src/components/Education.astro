---
import { profile } from '../data/profile';
import SectionHead from './SectionHead.astro';

const columns = [
  { heading: 'Education', items: profile.education },
  { heading: 'Certifications & professional development', items: profile.certifications },
];
---

<section class="section" id="education" aria-labelledby="education-title">
  <div class="container">
    <SectionHead id="education-title" eyebrow="05 — Learning" {...profile.sections.education} />

    <div class="columns">
      {
        columns.map((col) => (
          <div class="column">
            <h3>{col.heading}</h3>
            <ul class="items">
              {col.items.map((item) => (
                <li class="item">
                  <span class="year">{item.year}</span>
                  <div>
                    <p class="title">{item.title}</p>
                    <p class="issuer">
                      {item.issuer}
                      {item.note && <span> · {item.note}</span>}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  h3 {
    font-family: var(--sans);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--ink);
  }

  .item {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .year {
    font-family: var(--serif);
    font-size: 1.125rem;
    color: var(--accent);
    line-height: 1.4;
  }

  .title {
    font-family: var(--serif);
    font-size: 1.25rem;
    line-height: 1.35;
  }

  .issuer {
    margin-top: 0.2rem;
    font-size: 0.95rem;
    color: var(--ink-3);
  }

  @media (max-width: 820px) {
    .columns {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
