---
import { profile } from '../data/profile';
import SectionHead from './SectionHead.astro';
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="container">
    <SectionHead id="about-title" eyebrow="01 — What I do" {...profile.sections.about} />

    <div class="pillars">
      {
        profile.pillars.map((pillar, i) => (
          <article class="pillar">
            <span class="index" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{pillar.title}</h3>
            <p class="summary">{pillar.summary}</p>
            <ul class="dash-list">
              {pillar.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .pillar {
    padding-top: 1.5rem;
    border-top: 1px solid var(--ink);
  }

  .index {
    display: block;
    font-size: 0.8125rem;
    color: var(--ink-3);
    margin-bottom: 1rem;
  }

  h3 {
    font-size: 1.625rem;
  }

  .summary {
    margin: 0.75rem 0 1.5rem;
    color: var(--ink);
  }

  .dash-list {
    font-size: 0.975rem;
  }

  @media (max-width: 900px) {
    .pillars {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
