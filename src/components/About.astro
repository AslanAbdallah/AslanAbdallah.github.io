---
import { profile } from '../data/profile';
import SectionHead from './SectionHead.astro';
---

<section class="section band" id="about" aria-labelledby="about-title">
  <div class="container">
    <SectionHead id="about-title" {...profile.home.about} />

    <div class="pillars" data-reveal-group>
      {
        profile.home.pillars.map((pillar) => (
          <article class="pillar">
            <h3>{pillar.title}</h3>
            <p class="summary">{pillar.summary}</p>
            <ul class="dash-list">
              {pillar.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }

  .pillar {
    padding: clamp(1.5rem, 3vw, 2rem);
    background: var(--paper-raised);
    border-top: 3px solid var(--accent);
    border-radius: 0 0 var(--radius) var(--radius);
  }

  .index {
    display: block;
    font-family: var(--serif);
    font-size: 1.125rem;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  h3 {
    font-size: 1.625rem;
  }

  .summary {
    margin: 0.75rem 0 1.5rem;
    color: var(--ink);
  }

  .dash-list {
    font-size: 0.975rem;
  }

  @media (max-width: 900px) {
    .pillars {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
