---
import { profile } from '../data/profile';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container">
    <p class="meta">{profile.role} · {profile.location}</p>
    <h1 id="hero-title">{profile.name}</h1>
    <p class="headline">{profile.headline}</p>
    <p class="intro">{profile.intro}</p>

    <div class="actions">
      <a class="btn btn-primary" href="#work">
        View work
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 3v10M3.5 8.5 8 13l4.5-4.5" /></svg>
      </a>
      {
        profile.cvUrl ? (
          <a class="btn btn-secondary" href={profile.cvUrl} download>
            Download CV
          </a>
        ) : (
          <a class="btn btn-secondary" href="#contact">
            Get in touch
          </a>
        )
      }
    </div>

    <dl class="stats">
      {
        profile.stats.map((stat) => (
          <div class="stat">
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(4rem, 11vw, 8.5rem) clamp(3.5rem, 7vw, 5.5rem);
  }

  .meta {
    font-size: 0.9375rem;
    color: var(--ink-3);
    margin-bottom: 1.25rem;
  }

  h1 {
    font-size: clamp(3rem, 8vw, 5.75rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .headline {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.5rem, 3.2vw, 2.25rem);
    line-height: 1.25;
    color: var(--accent);
    margin-top: 1.25rem;
    max-width: 22em;
  }

  .intro {
    margin-top: 1.75rem;
    max-width: 40rem;
    font-size: 1.125rem;
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    margin: clamp(3.5rem, 7vw, 5rem) 0 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  .stat {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.35rem;
  }

  .stat dd {
    order: -1;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    line-height: 1.1;
    color: var(--accent);
  }

  .stat dt {
    font-size: 0.9rem;
    color: var(--ink-3);
    line-height: 1.4;
  }

  @media (max-width: 820px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2rem;
    }
  }
</style>
