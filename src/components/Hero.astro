---
import { profile } from '../data/profile';

// The case study shown beside the name (set by `featuredCase` in profile.ts).
const featured = profile.caseStudies.find((study) => study.slug === profile.featuredCase);
if (!featured) throw new Error(`featuredCase "${profile.featuredCase}" is not a case study slug`);
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-text">
        <p class="meta">{profile.role} · {profile.location}</p>
        <h1 id="hero-title">{profile.name}</h1>
        <p class="headline">{profile.headline}</p>
        <p class="intro">{profile.intro}</p>

        <div class="actions">
          <a class="btn btn-primary" href="#selected-work">
            View work
            <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 3v10M3.5 8.5 8 13l4.5-4.5" /></svg>
          </a>
          {
            profile.cvUrl ? (
              <a class="btn btn-secondary" href={profile.cvUrl} download>
                Download CV
              </a>
            ) : (
              <a class="btn btn-secondary" href="#contact">
                Get in touch
              </a>
            )
          }
        </div>
      </div>

      <aside class="featured band" aria-labelledby="featured-title">
        <p class="eyebrow">Featured result</p>
        <p class="value">{featured.headline.value}</p>
        <p class="value-label">{featured.headline.label}</p>
        <p class="title" id="featured-title">{featured.title}</p>
        <p class="summary">{featured.summary}</p>
        <a class="more" href={`/case-studies/${featured.slug}/`}>
          Read the case study<span class="visually-hidden">: {featured.title}</span>{' '}
          <span aria-hidden="true">→</span>
        </a>
      </aside>
    </div>

    <dl class="numbers band">
      {
        profile.stats.map((stat) => (
          <div class="stat">
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(3rem, 6vw, 4.5rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .meta {
    font-size: 0.9375rem;
    color: var(--ink-3);
    margin-bottom: 1.25rem;
  }

  h1 {
    font-size: clamp(3rem, 7.5vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .headline {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.5rem, 3vw, 2.125rem);
    line-height: 1.25;
    /* Never below 24px, so the lighter main colour stays readable as large text. */
    color: var(--accent-large);
    margin-top: 1.25rem;
    max-width: 20em;
  }

  .intro {
    margin-top: 1.5rem;
    max-width: 38rem;
    font-size: 1.125rem;
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  /* One case study, beside the name */
  .featured {
    border-radius: 14px;
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .value {
    margin-top: 1.25rem;
    font-family: var(--serif);
    font-size: clamp(2.5rem, 4.6vw, 3.4rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .value-label {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .title {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font-family: var(--serif);
    font-size: 1.375rem;
    line-height: 1.25;
  }

  .summary {
    margin-top: 0.6rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .more {
    display: inline-block;
    margin-top: 1.25rem;
    font-weight: 500;
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
  }

  /* The four numbers, in a strip under the hero */
  .numbers {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding-block: clamp(1.25rem, 3vw, 1.75rem);
    border-radius: 14px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-inline: clamp(1.1rem, 2.5vw, 1.75rem);
  }

  .stat + .stat {
    border-left: 1px solid var(--rule);
  }

  .stat dd {
    order: -1;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2rem, 3.4vw, 2.6rem);
    line-height: 1;
  }

  .stat dt {
    font-size: 0.875rem;
    color: var(--ink-2);
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Phones and small tablets: the numbers go two by two. */
  @media (max-width: 760px) {
    .numbers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-block: 0;
    }

    .stat {
      padding-block: 1.25rem;
    }

    .stat + .stat {
      border-left: 0;
    }

    .stat:nth-child(even) {
      border-left: 1px solid var(--rule);
    }

    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }
  }
</style>
